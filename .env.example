# Copy to .env for local development. Never commit the real .env.

# Signs the Flask session cookie. Required in production.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
#
# Left commented on purpose. An empty value is worse than no value: the app
# would start and serve pages, then fail on every submission. Uncomment it with
# a real secret, or leave it out and get a loud warning at startup.
# SESSION_SECRET=

# Where the SQLite file lives. Defaults to ./data/badeel.db locally; the
# container overrides this to /data/badeel.db on the mounted volume.
# DATABASE_PATH=data/badeel.db

# Hours ahead of UTC used when rendering timestamps (Saudi Arabia is +3).
# DISPLAY_UTC_OFFSET_HOURS=3

# DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# Only needed to run scripts/migrate_from_supabase.py. The app itself never
# reads these.
# SUPABASE_URL=
# SUPABASE_KEY=
